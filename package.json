{
  "name": "openvibes-mcp",
  "version": "0.3.0",
  "private": false,
  "description": "Production-focused open-source MCP server for hosted and local multimodal AI generation.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "bin": {
    "openvibes": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "check": "npm run typecheck && npm run build && npm test",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "mcp",
    "meta-ai",
    "vibes",
    "ai-video",
    "ai-image",
    "comfyui",
    "coding-agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itzmoksh01/Openvibes.git"
  },
  "homepage": "https://github.com/itzmoksh01/Openvibes",
  "bugs": {
    "url": "https://github.com/itzmoksh01/Openvibes/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "typescript": "6.0.0"
  }
}
