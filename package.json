{
  "name": "openvibes-mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Universal open-source MCP bridge for AI creative workflows, with an evidence-gated Meta Vibes provider.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "openvibes": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "meta-ai",
    "vibes",
    "ai-video",
    "ai-image",
    "coding-agents"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  }
}