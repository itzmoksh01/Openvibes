# Local ComfyUI API endpoint (start ComfyUI separately)
COMFYUI_URL=http://127.0.0.1:8188

# Local Openvibes storage
OPENVIBES_DATA_DIR=./data
OPENVIBES_OUTPUT_DIR=./generated
OPENVIBES_LOG_LEVEL=info

# ComfyUI is loopback-only by default. Set true only for a trusted HTTPS endpoint.
OPENVIBES_ALLOW_REMOTE_COMFYUI=false
