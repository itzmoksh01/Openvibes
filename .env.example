# Local ComfyUI API endpoint (start ComfyUI separately)
COMFYUI_URL=http://127.0.0.1:8188

# Local Openvibes storage
OPENVIBES_DATA_DIR=./data
OPENVIBES_OUTPUT_DIR=./generated
OPENVIBES_LOG_LEVEL=info

# ComfyUI is loopback-only by default. Set true only for a trusted HTTPS endpoint.
OPENVIBES_ALLOW_REMOTE_COMFYUI=false

# UTC daily request caps (shared when Openvibes processes use the same SQLite DB).
# Set 0 for unlimited. These are request counts, not USD spending limits.
OPENVIBES_DAILY_CLOUDFLARE_LIMIT=20
OPENVIBES_DAILY_POLLINATIONS_LIMIT=20
OPENVIBES_DAILY_COMFYUI_LIMIT=0
